<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- السمة الأساسية. الخلفية تُطابق «الرَّق» فلا يومض أبيض قبل أول رسم. -->
    <style name="Theme.Nawawia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nawawia_vellum</item>
    </style>

    <!--
        سمة الإقلاع. كانت `MainActivity` تستدعي `installSplashScreen()` بالفعل
        بينما `themes.xml` لم يكن يحوي إلا سطرًا واحدًا بلا أي سمة إقلاع، فلم
        تكن شاشة الإقلاع تعمل إطلاقًا رغم إضافة حزمة core-splashscreen.
    -->
    <style name="Theme.Nawawia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nawawia_lapis</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Nawawia</item>
    </style>

    <!-- مُبقاة لئلا ينكسر أي مرجع قديم. -->
    <style name="Theme.MyApplication" parent="Theme.Nawawia" />
</resources>
