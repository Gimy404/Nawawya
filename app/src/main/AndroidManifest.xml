<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- لفتح الشرح في متصفّح مُدار (Custom Tabs) فقط. التطبيق نفسه يعمل بلا شبكة. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        التذكير اليومي.
        POST_NOTIFICATIONS مطلوب من API 33، ويُطلب من المستخدم **في سياقه** بعد أن
        يبدأ سلسلته فعلًا — لا عند أول إقلاع.
        RECEIVE_BOOT_COMPLETED لإعادة تسليح المنبّه بعد إعادة التشغيل، فالمنبّهات
        تُمحى عند الإطفاء.
        ولا نطلب SCHEDULE_EXACT_ALARM ولا USE_EXACT_ALARM: تذكير مذاكرة لا منبّه،
        و setAndAllowWhileIdle يعمل في Doze بلا أي إذن.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name="com.nawawia.NawawiaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nawawia"
        tools:targetApi="33">

        <activity
            android:name="com.example.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nawawia.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.nawawia.data.notify.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nawawia.action.DAILY_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
